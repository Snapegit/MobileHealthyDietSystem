<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.BinglidanDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.BinglidanEntity" id="binglidanMap">
        <result property="jiuzhenshijian" column="jiuzhenshijian"/>
        <result property="zhusu" column="zhusu"/>
        <result property="bingshi" column="bingshi"/>
        <result property="zhenduan" column="zhenduan"/>
        <result property="fujian" column="fujian"/>
        <result property="yonghuzhanghao" column="yonghuzhanghao"/>
        <result property="yonghuxingming" column="yonghuxingming"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.BinglidanView" >

		SELECT  binglidan.* FROM binglidan  binglidan 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.BinglidanView" >
		SELECT * FROM binglidan  binglidan <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
