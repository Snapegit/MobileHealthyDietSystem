<?xml version="1.0" encoding="utf-8"?>
<com.design.appproject.widget.MyScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/add_box_style"
    android:fillViewport="true">
    <com.design.appproject.widget.MyLinearLayout
        style="@style/add_form_style"
        android:orientation="vertical">
    <com.design.appproject.widget.MyFlexBoxLayout
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="体检日期"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyTextView
            android:id="@+id/tijianriqi_tv"
            android:text="请选择体检日期"
            style="@style/add_item_picker_box_style"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/zhuyaobingshi_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="主要病史"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/zhuyaobingshi_et"
            style="@style/add_item_input_style"
            android:hint="主要病史"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/shengao_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="身高/cm"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/shengao_et"
            style="@style/add_item_input_style"
            android:hint="身高/cm"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/tizhong_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="体重/kg"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/tizhong_et"
            style="@style/add_item_input_style"
            android:hint="体重/kg"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/jianchaxiangmu_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="检查项目"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/jianchaxiangmu_et"
            style="@style/add_item_input_style"
            android:hint="检查项目"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
        <com.design.appproject.widget.MyFlexBoxLayout
            android:id="@+id/jianchajieguo_ll"
            style="@style/add_item_box_style">
            <com.design.appproject.widget.MyTextView
                android:text="检查结果"
                style="@style/add_item_label_style"/>
            <com.design.appproject.widget.MyTextView
                android:id="@+id/jianchajieguo_tv"
                android:text="点击上传检查结果"
                style="@style/add_item_text_style"/>
        </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/jianchayijian_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="检查意见"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/jianchayijian_et"
            style="@style/add_item_input_style"
            android:hint="检查意见"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/beizhu_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="备注"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/beizhu_et"
            style="@style/add_item_input_style"
            android:hint="备注"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
        <com.design.appproject.widget.MyFlexBoxLayout
            android:id="@+id/fujian_ll"
            style="@style/add_item_box_style">
            <com.design.appproject.widget.MyTextView
                android:text="附件"
                style="@style/add_item_label_style"/>
            <com.design.appproject.widget.MyTextView
                android:id="@+id/fujian_tv"
                android:text="点击上传附件"
                style="@style/add_item_text_style"/>
        </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/yonghuzhanghao_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="用户账号"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/yonghuzhanghao_et"
            style="@style/add_item_input_style"
            android:hint="用户账号"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFlexBoxLayout
        android:id="@+id/yonghuxingming_ll"
        style="@style/add_item_box_style">
        <com.design.appproject.widget.MyTextView
            android:text="用户姓名"
            style="@style/add_item_label_style"/>
        <com.design.appproject.widget.MyEditTextView
            android:id="@+id/yonghuxingming_et"
            style="@style/add_item_input_style"
            android:hint="用户姓名"/>
    </com.design.appproject.widget.MyFlexBoxLayout>
    <com.design.appproject.widget.MyFrameLayout
        style="@style/add_btn_box_style">
        <com.design.appproject.widget.MyButton
            android:id="@+id/submit_btn"
            android:text="提交"
            android:gravity="center"
        style="@style/add_btn_submit_style"/>
    </com.design.appproject.widget.MyFrameLayout>
    </com.design.appproject.widget.MyLinearLayout>
</com.design.appproject.widget.MyScrollView>
